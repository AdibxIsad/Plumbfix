  <tr><td class='label-col'>Actor:</td><td colspan='2'>Staff, Admin</td></tr>
  <tr><td class='label-col'>Description:</td><td colspan='2'>Admin approves or rejects the customer's payment submission.</td></tr>
  <tr><td class='label-col'>Preconditions:</td><td colspan='2'>Admin is logged in and on the Payment Verification page.</td></tr>
  <tr><td class='label-col'>Postconditions:</td><td colspan='2'>Payment record and booking status are updated.</td></tr>
  <tr><td class='label-col'>Priority:</td><td colspan='2'>High</td></tr>
  <tr><td class='label-col'>Frequency of Use:</td><td colspan='2'>High</td></tr>
