<h4>Domain Layer (Controllers) (SDD_PKG_200)</h4>
<table>
    <thead>
        <tr>
            <th style="width: 25%;">CLASS ID</th>
            <th style="width: 30%;">CLASS NAME</th>
            <th style="width: 45%;">FUNCTION</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>SDD_CLASS_201</td><td>LoginController</td><td>Handle user authentication, credential validation, and session initiation</td></tr>
        <tr><td>SDD_CLASS_202</td><td>RegisterController</td><td>Handle customer profile registration data validation and account creation</td></tr>
        <tr><td>SDD_CLASS_203</td><td>ChatController</td><td>Handle real-time messaging, fetching chat logs, and broadcasting messages</td></tr>
        <tr><td>SDD_CLASS_204</td><td>GoogleAuthController</td><td>Handle single sign-on (SSO) OAuth authentication via Google accounts</td></tr>
        <tr><td>SDD_CLASS_205</td><td>CustomerController</td><td>Process customer booking submissions, profile updates, and cancellations</td></tr>
        <tr><td>SDD_CLASS_206</td><td>StaffController</td><td>Process staff operations, plumber job assignments, and work status updates</td></tr>
        <tr><td>SDD_CLASS_207</td><td>PlumberController</td><td>Manage plumber accounts, registration, and status deactivations by Admin</td></tr>
        <tr><td>SDD_CLASS_208</td><td>PaymentController</td><td>Process customer deposit uploads and receipt file attachments</td></tr>
        <tr><td>SDD_CLASS_209</td><td>PaymentVerificationController</td><td>Handle admin payment approvals, rejection reasoning, and plumber assignments</td></tr>
        <tr><td>SDD_CLASS_210</td><td>RefundController</td><td>Manage customer cancellation refund calculations, slip uploads, and settlements</td></tr>
        <tr><td>SDD_CLASS_211</td><td>AnalyticsController</td><td>Aggregate booking statistics, monthly revenue data, and MoM performance metrics</td></tr>
        <tr><td>SDD_CLASS_212</td><td>InvoiceController</td><td>Generate and stream downloadable PDF invoices and service receipts</td></tr>
    </tbody>
</table>

