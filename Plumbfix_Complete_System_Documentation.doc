<!-- Section 5.1 -->
<h2>5.1 Detailed Design Specification</h2>

<h3>5.1.1 Class Attributes & Methods</h3>

<h4>Table Name: staff</h4>
<table>
    <thead><tr><th style="width: 35%;">Attributes</th><th style="width: 65%;">Description</th></tr></thead>
    <tbody>
        <tr><td>staffID</td><td>Primary key for staff member or plumber</td></tr>
        <tr><td>adminID</td><td>Foreign key referencing managing admin staff ID</td></tr>
        <tr><td>staffName</td><td>Staff member’s full name</td></tr>
        <tr><td>staffEmail</td><td>Staff member’s email address</td></tr>
        <tr><td>staffPhoneNo</td><td>Staff member’s contact phone number</td></tr>
        <tr><td>staffPassword</td><td>Hashed password for staff account</td></tr>
        <tr><td>staffStatus</td><td>Current account status of staff member (e.g. active, inactive)</td></tr>
    </tbody>
</table>

<h4>Table Name: customer</h4>
<table>
    <thead><tr><th style="width: 35%;">Attributes</th><th style="width: 65%;">Description</th></tr></thead>
    <tbody>
        <tr><td>customerID</td><td>Primary key for customer</td></tr>
        <tr><td>customerName</td><td>Customer’s full name</td></tr>
        <tr><td>customerEmail</td><td>Customer’s email address</td></tr>
        <tr><td>customerPhoneNo</td><td>Customer’s contact phone number</td></tr>
        <tr><td>customerAddress</td><td>Customer’s residential or service address</td></tr>
        <tr><td>customerPassword</td><td>Hashed password for customer account</td></tr>
        <tr><td>customerBankName</td><td>Customer’s bank name for refund processing</td></tr>
        <tr><td>customerBankAccountNo</td><td>Customer’s bank account number for refund processing</td></tr>
    </tbody>
</table>

<h4>Table Name: booking</h4>
<table>
    <thead><tr><th style="width: 35%;">Attributes</th><th style="width: 65%;">Description</th></tr></thead>
    <tbody>
        <tr><td>bookingID</td><td>Primary key for booking</td></tr>
        <tr><td>customerID</td><td>Foreign key referencing booking customer</td></tr>
        <tr><td>staffID</td><td>Foreign key referencing assigned plumber/staff member</td></tr>
        <tr><td>bookingType</td><td>Category of plumbing service requested</td></tr>
        <tr><td>bookingProblem</td><td>Short summary title of plumbing issue</td></tr>
        <tr><td>bookingIssueDescription</td><td>Detailed description of plumbing issue</td></tr>
        <tr><td>bookingDate</td><td>Scheduled date of appointment</td></tr>
        <tr><td>bookingTime</td><td>Scheduled time slot of appointment</td></tr>
        <tr><td>bookingStatus</td><td>Status of booking (e.g. pending, in_progress, completed, cancelled)</td></tr>
        <tr><td>bookingAttachment</td><td>File storage path of uploaded issue photo attachment</td></tr>
    </tbody>
</table>

<h4>Table Name: payment</h4>
<table>
    <thead><tr><th style="width: 35%;">Attributes</th><th style="width: 65%;">Description</th></tr></thead>
    <tbody>
        <tr><td>paymentID</td><td>Primary key for payment</td></tr>
        <tr><td>cancellationID</td><td>Foreign key referencing associated cancellation</td></tr>
        <tr><td>depositAmount</td><td>Amount of deposit paid by customer</td></tr>
        <tr><td>depositStatus</td><td>Status of deposit payment (e.g. unpaid, paid)</td></tr>
        <tr><td>verificationStatus</td><td>Staff verification status (e.g. pending, approved, rejected)</td></tr>
        <tr><td>submittedAt</td><td>Timestamp when payment proof was submitted</td></tr>
        <tr><td>verifiedAt</td><td>Timestamp when payment was verified by staff</td></tr>
        <tr><td>verifiedBy</td><td>Foreign key referencing staff member who verified payment</td></tr>
        <tr><td>rejectionReason</td><td>Reason for payment rejection if applicable</td></tr>
        <tr><td>paymentMethod</td><td>Payment method used (e.g. Online Transfer)</td></tr>
    </tbody>
</table>

<h3>5.1.2 Method Description</h3>

<h4>Class name: AccountManager</h4>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>login()</strong></td>
            <td style="width: 75%;">
                To login to customer or staff user account<br><br>
                <strong>Program Description Language</strong>
<pre>
public function login() {
    if ($_SERVER["REQUEST_METHOD"] == "POST") {
        $email = $_POST['email'];
        $password = $_POST['password'];
        
        $sql = "SELECT * FROM customers WHERE customerEmail='$email' 
                UNION 
                SELECT * FROM staffs WHERE staffEmail='$email'";
        $result = mysqli_query($this->conn, $sql);
        
        if (mysqli_num_rows($result) == 1) {
            $row = mysqli_fetch_assoc($result);
            if (password_verify($password, $row['password'])) {
                $_SESSION['userID'] = $row['id'];
                $_SESSION['role'] = $row['role'];
                header("Location: dashboard.php");
                exit;
            } else {
                $this->message = "❌ Incorrect password!";
            }
        } else {
            $this->message = "⚠ Email not found!";
        }
    }
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

