<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
<meta charset="utf-8">
<title>Data Dictionary - Plumbfix Plumbing Management System</title>
<style>
@page {
    size: A4;
    margin: 1in;
}
body {
    font-family: 'Calibri', 'Arial', sans-serif;
    font-size: 11pt;
    line-height: 1.4;
    color: #222222;
}
h1 {
    font-family: 'Calibri', sans-serif;
    font-size: 20pt;
    color: #1F4E78;
    margin-top: 0;
    margin-bottom: 12pt;
    font-weight: bold;
    text-align: center;
    border-bottom: 2px solid #1F4E78;
    padding-bottom: 6px;
}
h2 {
    font-family: 'Calibri', sans-serif;
    font-size: 14pt;
    color: #2E75B6;
    margin-top: 18pt;
    margin-bottom: 6pt;
    font-weight: bold;
    border-bottom: 1px solid #D9D9D9;
    padding-bottom: 3px;
}
p {
    margin-bottom: 8pt;
}
table {
    border-collapse: collapse;
    width: 100%;
    margin-bottom: 18pt;
}
th {
    background-color: #1F4E78;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 10.5pt;
    padding: 6px 8px;
    border: 1px solid #1F4E78;
    text-align: left;
}
td {
    padding: 6px 8px;
    border: 1px solid #D9D9D9;
    font-size: 10pt;
    vertical-align: top;
}
tr:nth-child(even) td {
    background-color: #F2F5F8;
}
.legend-box {
    background-color: #F8F9FA;
    border: 1px solid #CCCCCC;
    padding: 8px 12px;
    margin-bottom: 16pt;
    font-size: 10pt;
}
.text-center {
    text-align: center;
}
</style>
</head>
<body>

<h1>Plumbfix: Plumbing Management System — Data Dictionary</h1>

<div class="legend-box">
    <strong>Legend:</strong><br>
    <strong>M</strong> = Mandatory? (<strong>Y</strong> = Yes / NOT NULL, <strong>N</strong> = No / NULLable)<br>
    <strong>U</strong> = Unique? (<strong>Y</strong> = Yes / Primary Key / Unique, <strong>N</strong> = No)
</div>

<h2>1. Staff</h2>
<table>
    <thead>
        <tr>
            <th>Attribute Name</th>
            <th>Description</th>
            <th>Type</th>
            <th>Additional Type Information</th>
            <th>Default Value</th>
            <th class="text-center">M</th>
            <th class="text-center">U</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><strong>staffID</strong></td>
            <td>Primary Key ID for each staff member</td>
            <td>int</td>
            <td>max = 11</td>
            <td>AUTO_INCREMENT</td>
            <td class="text-center">Y</td>
            <td class="text-center">Y</td>
        </tr>
        <tr>
            <td><strong>adminID</strong></td>
            <td>Foreign Key ID for managing admin</td>
            <td>int</td>
            <td>max = 11</td>
            <td>-</td>
            <td class="text-center">N</td>
            <td class="text-center">N</td>
        </tr>
        <tr>
            <td><strong>staffName</strong></td>
            <td>Full name of staff member</td>
            <td>varchar</td>
            <td>max = 255</td>
            <td>-</td>
            <td class="text-center">Y</td>
            <td class="text-center">N</td>
        </tr>
        <tr>
            <td><strong>staffEmail</strong></td>
            <td>Email address of staff member</td>
            <td>varchar</td>
            <td>max = 255</td>
            <td>-</td>
            <td class="text-center">Y</td>
            <td class="text-center">Y</td>
        </tr>
        <tr>
            <td><strong>staffPhoneNo</strong></td>
            <td>Phone number of staff member</td>
            <td>varchar</td>
            <td>max = 20</td>
            <td>-</td>
            <td class="text-center">Y</td>
            <td class="text-center">N</td>
        </tr>
        <tr>
            <td><strong>staffPassword</strong></td>
            <td>Hashed account password</td>
            <td>varchar</td>
            <td>max = 255</td>
            <td>-</td>
            <td class="text-center">Y</td>
            <td class="text-center">N</td>
        </tr>
        <tr>
            <td><strong>staffStatus</strong></td>
            <td>Account status (e.g. active, inactive)</td>
            <td>varchar</td>
            <td>max = 50</td>
            <td>'active'</td>
            <td class="text-center">Y</td>
            <td class="text-center">N</td>
        </tr>
    </tbody>
</table>

<h2>2. Customer</h2>
<table>
    <thead>
        <tr>
            <th>Attribute Name</th>
            <th>Description</th>
            <th>Type</th>
            <th>Additional Type Information</th>
