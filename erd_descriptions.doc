<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
<meta charset="utf-8">
<title>ERD Entity Descriptions - Plumbfix</title>
<style>
@page {
    size: A4;
    margin: 1in;
}
body {
    font-family: 'Calibri', 'Arial', sans-serif;
    font-size: 11pt;
    line-height: 1.4;
    color: #222222;
}
h1 {
    font-family: 'Calibri', sans-serif;
    font-size: 20pt;
    color: #1F4E78;
    margin-top: 0;
    margin-bottom: 12pt;
    font-weight: bold;
    text-align: center;
    border-bottom: 2px solid #1F4E78;
    padding-bottom: 6px;
}
table {
    border-collapse: collapse;
    width: 100%;
    margin-bottom: 18pt;
}
th {
    background-color: #1F4E78;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 11pt;
    padding: 8px 10px;
    border: 1px solid #1F4E78;
    text-align: left;
}
td {
    padding: 8px 10px;
    border: 1px solid #D9D9D9;
    font-size: 10.5pt;
    vertical-align: top;
}
tr:nth-child(even) td {
    background-color: #F2F5F8;
}
</style>
</head>
<body>

<h1>Plumbfix: Plumbing Management System — ERD Entity Descriptions</h1>

<table>
    <thead>
        <tr>
            <th style="width: 30%;">Entity</th>
            <th style="width: 70%;">Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><strong>Staff</strong> (<code>staffs</code>)</td>
            <td>Store the information of staff members and plumbers</td>
        </tr>
        <tr>
            <td><strong>Customer</strong> (<code>customers</code>)</td>
            <td>Store the information of registered customers</td>
        </tr>
        <tr>
            <td><strong>Notification</strong> (<code>notifications</code>)</td>
            <td>Store the information of system and push notifications</td>
        </tr>
        <tr>
            <td><strong>Booking</strong> (<code>bookings</code>)</td>
            <td>Store the information of service bookings</td>
        </tr>
        <tr>
            <td><strong>Payment</strong> (<code>payments</code>)</td>
            <td>Store the information of booking payments and verification statuses</td>
        </tr>
        <tr>
            <td><strong>PaymentReceipt</strong> (<code>payment_receipts</code>)</td>
            <td>Store the information of uploaded payment receipt files</td>
        </tr>
        <tr>
            <td><strong>Cancellation</strong> (<code>cancellations</code>)</td>
            <td>Store the information of cancelled service bookings</td>
        </tr>
        <tr>
            <td><strong>Refund</strong> (<code>refunds</code>)</td>
            <td>Store the information of refund requests and refund proof slips</td>
        </tr>
        <tr>
            <td><strong>JobRecord</strong> (<code>job_records</code>)</td>
            <td>Store the information of completed plumbing jobs and service costs</td>
        </tr>
        <tr>
            <td><strong>Feedback</strong> (<code>feedbacks</code>)</td>
            <td>Store the information of customer ratings, reviews, and staff responses</td>
        </tr>
        <tr>
            <td><strong>ChatMessage</strong> (<code>chat_messages</code>)</td>
            <td>Store the information of chat messages for each booking</td>
        </tr>
    </tbody>
</table>

</body>
</html>
