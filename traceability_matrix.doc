<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
<meta charset="utf-8">
<title>Requirements Traceability Matrix - Plumbfix</title>
<style>
@page {
    size: A3 landscape;
    margin: 0.5in;
}
body {
    font-family: 'Calibri', 'Arial', sans-serif;
    font-size: 8pt;
}
h1 {
    font-size: 14pt;
    color: #1f4e78;
    margin-bottom: 10px;
}
table {
    border-collapse: collapse;
    width: 100%;
}
th, td {
    border: 1px solid #000000;
    text-align: center;
    padding: 3px 2px;
    font-size: 8pt;
}
.pkg-header-100 {
    background-color: #e2efda; /* Light green / pink style */
    font-weight: bold;
}
.pkg-header-200 {
    background-color: #c6e0b4; /* Green */
    font-weight: bold;
}
.pkg-header-300 {
    background-color: #fce4d6; /* Light orange / red */
    font-weight: bold;
}
.class-header-100 {
    background-color: #edd9f2;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    height: 110px;
    font-size: 7.5pt;
    font-weight: bold;
}
.class-header-200 {
    background-color: #fff2cc;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    height: 110px;
    font-size: 7.5pt;
    font-weight: bold;
}
.class-header-300 {
    background-color: #f8cecc;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    height: 110px;
    font-size: 7.5pt;
    font-weight: bold;
}
.srs-cell {
    background-color: #fff2cc;
    font-weight: bold;
    text-align: left;
    white-space: nowrap;
    padding-left: 6px;
}
.check-cell {
    font-weight: bold;
    font-size: 10pt;
}
</style>
</head>
<body>

<h1>Plumbfix Requirements Traceability Matrix (RTM)</h1>

<table>
  <thead>
    <!-- ROW 1: PACKAGES -->
    <tr>
      <th rowspan="2" style="background-color: #fce4d6; font-size: 9pt;">PACKAGE<br><br>CLASS / REQUIREMENT</th>
      <th colspan="16" style="background-color: #e1d5e7; font-size: 9.5pt;">SDD_PKG_100 (Presentation Layer - Blade Views)</th>
      <th colspan="12" style="background-color: #d5e8d4; font-size: 9.5pt;">SDD_PKG_200 (Domain Layer - Controllers)</th>
      <th colspan="11" style="background-color: #f8cecc; font-size: 9.5pt;">SDD_PKG_300 (Data Access Layer - Eloquent Models)</th>
    </tr>
    <!-- ROW 2: CLASSES -->
    <tr>
