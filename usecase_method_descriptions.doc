<h1>Plumbfix: Plumbing Management System</h1>
<h2>5.1.2 Method Description</h2>

<h3>Class name: AccountManager</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>login()</strong></td>
            <td style="width: 75%;">
                To login to customer or staff user account<br><br>
                <strong>Program Description Language</strong>
<pre>
public function login() {
    if ($_SERVER["REQUEST_METHOD"] == "POST") {
        $email = $_POST['email'];
        $password = $_POST['password'];
        
        $sql = "SELECT * FROM customers WHERE customerEmail='$email' 
                UNION 
                SELECT * FROM staffs WHERE staffEmail='$email'";
        $result = mysqli_query($this->conn, $sql);
        
        if (mysqli_num_rows($result) == 1) {
            $row = mysqli_fetch_assoc($result);
            if (password_verify($password, $row['password'])) {
                $_SESSION['userID'] = $row['id'];
                $_SESSION['role'] = $row['role'];
                header("Location: dashboard.php");
                exit;
            } else {
                $this->message = "❌ Incorrect password!";
            }
        } else {
            $this->message = "⚠ Email not found!";
        }
    }
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>createAccount()</strong></td>
            <td>
                To create a new customer account or staff account profile<br><br>
                <strong>Program Description Language</strong>
<pre>
public function createAccount() {
    if ($_SERVER["REQUEST_METHOD"] == "POST") {
        $name = $_POST['name'];
        $email = $_POST['email'];
        $phone = $_POST['phone'];
        $pass = password_hash($_POST['password'], PASSWORD_DEFAULT);
        
        $checkEmail = "SELECT * FROM customers WHERE customerEmail='$email'";
        $result = mysqli_query($this->conn, $checkEmail);
        
        if (mysqli_num_rows($result) > 0) {
            $this->message = "⚠ Email already registered!";
        } else {
            $sql = "INSERT INTO customers (customerName, customerEmail, customerPhoneNo, customerPassword) 
                    VALUES ('$name','$email','$phone','$pass')";
            if (mysqli_query($this->conn, $sql)) {
                $this->message = "✅ Account created successfully!";
            } else {
                $this->message = "❌ Error: " . mysqli_error($this->conn);
            }
        }
    }
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>viewAccount()</strong></td>
            <td>
                To retrieve and display user account profile details<br><br>
                <strong>Program Description Language</strong>
<pre>
public function viewAccount($userID) {
    $sql = "SELECT * FROM customers WHERE customerID='$userID'";
    $result = mysqli_query($this->conn, $sql);
    if ($row = mysqli_fetch_assoc($result)) {
        return $row;
    } else {
        $this->message = "⚠ Account not found!";
        return null;
    }
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>updateAccount()</strong></td>
            <td>
                To update user account contact details, address, and profile fields<br><br>
                <strong>Program Description Language</strong>
<pre>
public function updateAccount($userID) {
    if ($_SERVER["REQUEST_METHOD"] == "POST") {
        $phone = $_POST['phone'];
        $address = $_POST['address'];
        
        $sql = "UPDATE customers SET customerPhoneNo='$phone', customerAddress='$address' 
                WHERE customerID='$userID'";
        if (mysqli_query($this->conn, $sql)) {
            $this->message = "✅ Profile updated successfully!";
        } else {
            $this->message = "❌ Update error: " . mysqli_error($this->conn);
        }
    }
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>deleteAccount()</strong></td>
            <td>
                To delete or deactivate a staff profile or customer account<br><br>
                <strong>Program Description Language</strong>
<pre>
public function deleteAccount($userID) {
    $sql = "DELETE FROM customers WHERE customerID='$userID'";
    if (mysqli_query($this->conn, $sql)) {
        $this->message = "✅ Account deleted successfully!";
    } else {
        $this->message = "❌ Delete failed: " . mysqli_error($this->conn);
    }
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

<h3>Class name: BookingManager</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>createBooking()</strong></td>
            <td style="width: 75%;">
                To create a new service booking appointment request<br><br>
                <strong>Program Description Language</strong>
<pre>
public function createBooking() {
    if ($_SERVER["REQUEST_METHOD"] == "POST") {
        $customerID = $_SESSION['userID'];
        $type = $_POST['bookingType'];
        $problem = $_POST['bookingProblem'];
        $date = $_POST['bookingDate'];
        $time = $_POST['bookingTime'];
        
        $sql = "INSERT INTO bookings (customerID, bookingType, bookingProblem, bookingDate, bookingTime, bookingStatus) 
                VALUES ('$customerID','$type','$problem','$date','$time','pending')";
        if (mysqli_query($this->conn, $sql)) {
            $this->message = "✅ Booking submitted successfully!";
        } else {
            $this->message = "❌ Booking failed: " . mysqli_error($this->conn);
        }
    }
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>viewBooking()</strong></td>
            <td>
                To view single or list of service booking appointments<br><br>
                <strong>Program Description Language</strong>
<pre>
public function viewBooking($customerID) {
    $sql = "SELECT * FROM bookings WHERE customerID='$customerID' ORDER BY bookingDate DESC";
    $result = mysqli_query($this->conn, $sql);
    $bookings = array();
    while ($row = mysqli_fetch_assoc($result)) {
        $bookings[] = $row;
    }
    return $bookings;
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>updateBooking()</strong></td>
            <td>
                To update appointment status, schedule slot, or assign plumber<br><br>
                <strong>Program Description Language</strong>
<pre>
public function updateBooking($bookingID, $status, $staffID) {
    $sql = "UPDATE bookings SET bookingStatus='$status', staffID='$staffID' WHERE bookingID='$bookingID'";
    if (mysqli_query($this->conn, $sql)) {
        $this->message = "✅ Booking updated successfully!";
    } else {
        $this->message = "❌ Update failed: " . mysqli_error($this->conn);
    }
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>deleteBooking()</strong></td>
            <td>
                To cancel an existing booking appointment and process cancellation reason<br><br>
                <strong>Program Description Language</strong>
<pre>
public function deleteBooking($bookingID, $reason) {
    $sql = "UPDATE bookings SET bookingStatus='cancelled' WHERE bookingID='$bookingID'";
    if (mysqli_query($this->conn, $sql)) {
        $sqlCancel = "INSERT INTO cancellations (bookingID, reason, cancelledAt) VALUES ('$bookingID', '$reason', NOW())";
        mysqli_query($this->conn, $sqlCancel);
        $this->message = "✅ Booking cancelled successfully!";
    } else {
        $this->message = "❌ Cancellation failed: " . mysqli_error($this->conn);
    }
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

<h3>Class name: PaymentManager</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>createPayment()</strong></td>
            <td style="width: 75%;">
                To submit deposit payment details and upload receipt proof<br><br>
                <strong>Program Description Language</strong>
<pre>
public function createPayment($bookingID, $receiptPath, $method) {
    $sql = "INSERT INTO payments (bookingID, depositAmount, depositStatus, verificationStatus, paymentMethod, submittedAt) 
            VALUES ('$bookingID', 50.00, 'unpaid', 'pending', '$method', NOW())";
    if (mysqli_query($this->conn, $sql)) {
        $paymentID = mysqli_insert_id($this->conn);
        $sqlReceipt = "INSERT INTO payment_receipts (paymentID, receiptPath, receiptStatus) VALUES ('$paymentID', '$receiptPath', 'pending')";
        mysqli_query($this->conn, $sqlReceipt);
        $this->message = "✅ Payment receipt uploaded!";
    }
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>viewPayment()</strong></td>
            <td>
                To retrieve transaction details and uploaded payment receipt proof<br><br>
                <strong>Program Description Language</strong>
<pre>
public function viewPayment($bookingID) {
    $sql = "SELECT p.*, pr.receiptPath FROM payments p 
            LEFT JOIN payment_receipts pr ON p.paymentID = pr.paymentID 
            WHERE p.bookingID='$bookingID'";
    $result = mysqli_query($this->conn, $sql);
    return mysqli_fetch_assoc($result);
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>updatePayment()</strong></td>
            <td>
                To approve or reject payment receipts and update verification status<br><br>
                <strong>Program Description Language</strong>
<pre>
public function updatePayment($paymentID, $status, $remarks) {
    $sql = "UPDATE payments SET verificationStatus='$status', depositStatus='paid', verifiedAt=NOW() WHERE paymentID='$paymentID'";
    if (mysqli_query($this->conn, $sql)) {
        $this->message = "✅ Payment verification status updated to $status!";
    }
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

<h3>Class name: RefundManager</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>createRefund()</strong></td>
            <td style="width: 75%;">
                To generate a refund application record for a cancelled booking<br><br>
                <strong>Program Description Language</strong>
<pre>
public function createRefund($cancellationID, $amount) {
    $sql = "INSERT INTO refunds (cancellationID, refundAmount, refundStatus) 
            VALUES ('$cancellationID', '$amount', 'pending')";
    mysqli_query($this->conn, $sql);
    $this->message = "✅ Refund request generated!";
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>viewRefund()</strong></td>
            <td>
                To display status and details of customer refund applications<br><br>
                <strong>Program Description Language</strong>
<pre>
public function viewRefund($refundID) {
    $sql = "SELECT * FROM refunds WHERE refundID='$refundID'";
    $result = mysqli_query($this->conn, $sql);
    return mysqli_fetch_assoc($result);
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>updateRefund()</strong></td>
            <td>
                To process refund settlement, upload bank transfer slip, and update status<br><br>
                <strong>Program Description Language</strong>
<pre>
public function updateRefund($refundID, $receiptPath, $remarks) {
    $sql = "UPDATE refunds SET refundStatus='refunded', receiptPath='$receiptPath', remarks='$remarks', completedAt=NOW() 
            WHERE refundID='$refundID'";
    if (mysqli_query($this->conn, $sql)) {
        $this->message = "✅ Refund processed and transfer proof uploaded!";
    }
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

<h3>Class name: JobRecordManager</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>createJobRecord()</strong></td>
            <td style="width: 75%;">
                To record completed plumbing job details, materials, and total cost<br><br>
                <strong>Program Description Language</strong>
<pre>
public function createJobRecord() {
    if ($_SERVER["REQUEST_METHOD"] == "POST") {
        $bookingID = $_POST['bookingID'];
        $staffID = $_SESSION['userID'];
        $totalCost = $_POST['totalCost'];
        $notes = $_POST['notes'];
        
        $sql = "INSERT INTO job_records (bookingID, staffID, jobRecordCompletionDate, jobRecordTotalCost, jobRecordNotes) 
                VALUES ('$bookingID','$staffID', NOW(),'$totalCost','$notes')";
        if (mysqli_query($this->conn, $sql)) {
            mysqli_query($this->conn, "UPDATE bookings SET bookingStatus='completed' WHERE bookingID='$bookingID'");
            $this->message = "✅ Job completion record created!";
        }
    }
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>viewJobRecord()</strong></td>
            <td>
                To retrieve and display completion report summary and invoice breakdown<br><br>
                <strong>Program Description Language</strong>
<pre>
public function viewJobRecord($bookingID) {
    $sql = "SELECT * FROM job_records WHERE bookingID='$bookingID'";
    $result = mysqli_query($this->conn, $sql);
    return mysqli_fetch_assoc($result);
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>updateJobRecord()</strong></td>
            <td>
                To modify existing job record details, cost calculations, or service notes<br><br>
                <strong>Program Description Language</strong>
<pre>
public function updateJobRecord($jobRecordID, $totalCost, $notes) {
    $sql = "UPDATE job_records SET jobRecordTotalCost='$totalCost', jobRecordNotes='$notes' 
            WHERE jobRecordID='$jobRecordID'";
    if (mysqli_query($this->conn, $sql)) {
        $this->message = "✅ Job record updated successfully!";
    }
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

<h3>Class name: AnalyticsManager</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>generateReport()</strong></td>
            <td style="width: 75%;">
                To aggregate business performance analytics and revenue reports<br><br>
                <strong>Program Description Language</strong>
<pre>
public function generateReport($year) {
    $sql = "SELECT MONTH(jobRecordCompletionDate) as month, SUM(jobRecordTotalCost) as totalSales 
            FROM job_records 
            WHERE YEAR(jobRecordCompletionDate) = '$year' 
            GROUP BY MONTH(jobRecordCompletionDate)";
    $result = mysqli_query($this->conn, $sql);
    $monthlySales = array_fill(1, 12, 0);
    while ($row = mysqli_fetch_assoc($result)) {
        $monthlySales[$row['month']] = $row['totalSales'];
    }
    return $monthlySales;
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

<h3>Class name: FeedbackManager</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>createFeedback()</strong></td>
            <td style="width: 75%;">
                To submit rating scores, reviews, and feedback comments<br><br>
                <strong>Program Description Language</strong>
<pre>
public function createFeedback() {
    if ($_SERVER["REQUEST_METHOD"] == "POST") {
        $customerID = $_SESSION['userID'];
        $bookingID = $_POST['bookingID'];
        $rating = $_POST['rating'];
        $comments = $_POST['comments'];
        
        $sql = "INSERT INTO feedbacks (customerID, bookingID, feedbackRating, feedbackComments) 
                VALUES ('$customerID','$bookingID','$rating','$comments')";
        if (mysqli_query($this->conn, $sql)) {
            $this->message = "✅ Thank you for your feedback!";
        }
    }
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>viewFeedback()</strong></td>
            <td>
                To display review board ratings, customer comments, and staff replies<br><br>
                <strong>Program Description Language</strong>
<pre>
public function viewFeedback() {
    $sql = "SELECT f.*, c.customerName FROM feedbacks f JOIN customers c ON f.customerID = c.customerID";
    $result = mysqli_query($this->conn, $sql);
    $feedbacks = array();
    while ($row = mysqli_fetch_assoc($result)) {
        $feedbacks[] = $row;
    }
    return $feedbacks;
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

<h3>Class name: CommunicationManager</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>createChatMessage()</strong></td>
            <td style="width: 75%;">
                To send and record chat message entry for active booking session<br><br>
                <strong>Program Description Language</strong>
<pre>
public function createChatMessage($bookingID, $senderID, $senderType, $message) {
    $sql = "INSERT INTO chat_messages (bookingID, senderID, senderType, message, isRead) 
            VALUES ('$bookingID','$senderID','$senderType','$message', 0)";
    if (mysqli_query($this->conn, $sql)) {
        return true;
    }
    return false;
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>viewChatMessages()</strong></td>
            <td>
                To load conversation history and mark incoming unread messages as read<br><br>
                <strong>Program Description Language</strong>
<pre>
public function viewChatMessages($bookingID, $currentUserType) {
    $sql = "SELECT * FROM chat_messages WHERE bookingID='$bookingID' ORDER BY chatMessageID ASC";
    $result = mysqli_query($this->conn, $sql);
    
    $updateRead = "UPDATE chat_messages SET isRead=1 WHERE bookingID='$bookingID' AND senderType!='$currentUserType'";
    mysqli_query($this->conn, $updateRead);
    
    $messages = array();
    while ($row = mysqli_fetch_assoc($result)) {
        $messages[] = $row;
    }
    return $messages;
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>viewPushNotifications()</strong></td>
            <td>
                To query and display unread system push notifications for authenticated user<br><br>
                <strong>Program Description Language</strong>
<pre>
public function viewPushNotifications($userID) {
    $sql = "SELECT * FROM notifications WHERE notifiableID='$userID' AND readAt IS NULL ORDER BY createdAt DESC";
    $result = mysqli_query($this->conn, $sql);
    $notifications = array();
    while ($row = mysqli_fetch_assoc($result)) {
        $notifications[] = $row;
    }
    return $notifications;
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

</body>
</html>
