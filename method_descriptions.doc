<h1>Plumbfix: Plumbing Management System</h1>
<h2>5.1.2 Method Description</h2>

<h3>Class name: LoginController</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>login()</strong></td>
            <td style="width: 75%;">
                To authenticate user login credentials and establish role-based session<br><br>
                <strong>Program Description Language</strong>
<pre>
public function login(Request $request) {
    $credentials = $request->validate([
        'email' => 'required|email',
        'password' => 'required'
    ]);

    if (Auth::guard('customer')->attempt($credentials)) {
        $request->session()->regenerate();
        return redirect()->intended('/customer/dashboard');
    }

    if (Auth::guard('staff')->attempt($credentials)) {
        $request->session()->regenerate();
        return redirect()->intended('/staff/dashboard');
    }

    return back()->withErrors(['email' => 'Invalid email or password provided.']);
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>logout()</strong></td>
            <td>
                To terminate active user session and redirect to home page<br><br>
                <strong>Program Description Language</strong>
<pre>
public function logout(Request $request) {
    Auth::logout();
    $request->session()->invalidate();
    $request->session()->regenerateToken();
    return redirect('/login')->with('success', 'Logged out successfully.');
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

<h3>Class name: RegisterController</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>createAccount()</strong></td>
            <td style="width: 75%;">
                To register a new customer account in the system database<br><br>
                <strong>Program Description Language</strong>
<pre>
public function createAccount(Request $request) {
    $validated = $request->validate([
        'name' => 'required|string|max:255',
        'email' => 'required|string|email|unique:customers',
        'phone' => 'required|string|max:20',
        'address' => 'required|string',
        'password' => 'required|string|min:8|confirmed'
    ]);

    $customer = Customer::create([
        'customerName' => $validated['name'],
        'customerEmail' => $validated['email'],
        'customerPhoneNo' => $validated['phone'],
        'customerAddress' => $validated['address'],
        'customerPassword' => Hash::make($validated['password'])
    ]);

    Auth::guard('customer')->login($customer);
    return redirect('/customer/dashboard')->with('success', 'Account created successfully!');
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

<h3>Class name: CustomerController</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>bookingStore()</strong></td>
            <td style="width: 75%;">
                To create a new service booking appointment request<br><br>
                <strong>Program Description Language</strong>
<pre>
public function bookingStore(Request $request) {
    $validated = $request->validate([
        'bookingType' => 'required|string',
        'bookingProblem' => 'required|string|max:255',
        'bookingDate' => 'required|date|after:today',
        'bookingTime' => 'required',
        'attachment' => 'nullable|image|max:5120'
    ]);

    $path = null;
    if ($request->hasFile('attachment')) {
        $path = $request->file('attachment')->store('bookings', 'public');
    }

    $booking = Booking::create([
        'customerID' => Auth::id(),
        'bookingType' => $validated['bookingType'],
        'bookingProblem' => $validated['bookingProblem'],
        'bookingDate' => $validated['bookingDate'],
        'bookingTime' => $validated['bookingTime'],
        'bookingStatus' => 'pending',
        'bookingAttachment' => $path
    ]);

    return redirect()->route('customer.payment', $booking->bookingID)
                     ->with('success', 'Booking created! Please proceed with deposit payment.');
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>bookingDelete()</strong></td>
            <td>
                To cancel an existing booking appointment and process refund eligibility<br><br>
                <strong>Program Description Language</strong>
<pre>
public function bookingDelete(Request $request, $id) {
    $booking = Booking::where('customerID', Auth::id())->findOrFail($id);
    
    $booking->update([
        'bookingStatus' => 'cancelled'
    ]);

    $cancellation = Cancellation::create([
        'bookingID' => $booking->bookingID,
        'cancelledAt' => now(),
        'reason' => $request->input('reason', 'Customer Request'),
        'description' => $request->input('description')
    ]);

    if ($booking->payment && $booking->payment->depositStatus == 'paid') {
        Refund::create([
            'cancellationID' => $cancellation->cancellationID,
            'refundAmount' => $booking->payment->depositAmount,
            'refundStatus' => 'pending'
        ]);
    }

    return redirect('/customer/bookings')->with('success', 'Booking cancelled successfully.');
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

<h3>Class name: PaymentController</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>uploadReceipt()</strong></td>
            <td style="width: 75%;">
                To upload deposit payment receipt screenshot for booking verification<br><br>
                <strong>Program Description Language</strong>
<pre>
public function uploadReceipt(Request $request, $bookingID) {
    $request->validate([
        'receiptFile' => 'required|image|mimes:jpeg,png,jpg|max:5120',
        'paymentMethod' => 'required|string'
    ]);

    $path = $request->file('receiptFile')->store('receipts', 'public');

    $payment = Payment::updateOrCreate(
        ['bookingID' => $bookingID],
        [
            'depositAmount' => 50.00,
            'verificationStatus' => 'pending',
            'paymentMethod' => $request->paymentMethod,
            'submittedAt' => now()
        ]
    );

    PaymentReceipt::create([
        'paymentID' => $payment->paymentID,
        'receiptPath' => $path,
        'receiptStatus' => 'pending',
        'uploadedAt' => now()
    ]);

    return redirect('/customer/bookings')->with('success', 'Payment receipt uploaded! Awaiting staff verification.');
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

<h3>Class name: PaymentVerificationController</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>approve()</strong></td>
            <td style="width: 75%;">
                To approve customer payment receipt and assign a plumber staff member<br><br>
                <strong>Program Description Language</strong>
<pre>
public function approve(Request $request, $bookingID) {
    $request->validate(['staffID' => 'required|exists:staffs,staffID']);

    $booking = Booking::findOrFail($bookingID);
    $booking->payment->update([
        'verificationStatus' => 'approved',
        'depositStatus' => 'paid',
        'verifiedAt' => now(),
        'verifiedBy' => Auth::id()
    ]);

    $booking->update([
        'staffID' => $request->staffID,
        'bookingStatus' => 'in_progress'
    ]);

    return back()->with('success', 'Payment verified and plumber assigned successfully!');
}
</pre>
            </td>
        </tr>
        <tr>
            <td><strong>reject()</strong></td>
            <td>
                To reject invalid payment receipt and request re-upload from customer<br><br>
                <strong>Program Description Language</strong>
<pre>
public function reject(Request $request, $bookingID) {
    $request->validate(['rejectionReason' => 'required|string']);

    $booking = Booking::findOrFail($bookingID);
    $booking->payment->update([
        'verificationStatus' => 'rejected',
        'rejectionReason' => $request->rejectionReason
    ]);

    return back()->with('success', 'Payment receipt rejected with explanation sent to customer.');
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

<h3>Class name: StaffController</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>jobRecordStore()</strong></td>
            <td style="width: 75%;">
                To log completed job service details, total cost, and work notes<br><br>
                <strong>Program Description Language</strong>
<pre>
public function jobRecordStore(Request $request) {
    $validated = $request->validate([
        'bookingID' => 'required|exists:bookings,bookingID',
        'totalCost' => 'required|numeric|min:0',
        'notes' => 'nullable|string',
        'completionDate' => 'required|date'
    ]);

    JobRecord::create([
        'bookingID' => $validated['bookingID'],
        'staffID' => Auth::id(),
        'jobRecordCompletionDate' => $validated['completionDate'],
        'jobRecordTotalCost' => $validated['totalCost'],
        'jobRecordNotes' => $validated['notes']
    ]);

    Booking::where('bookingID', $validated['bookingID'])->update([
        'bookingStatus' => 'completed'
    ]);

    return redirect('/staff/job-records')->with('success', 'Job completion record created successfully!');
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

<h3>Class name: RefundController</h3>
<table>
    <tbody>
        <tr>
            <td style="width: 25%;"><strong>markAsRefunded()</strong></td>
            <td style="width: 75%;">
                To process refund transfer payment to customer and upload proof slip<br><br>
                <strong>Program Description Language</strong>
<pre>
public function markAsRefunded(Request $request, $refundID) {
    $request->validate([
        'receiptFile' => 'required|image|max:5120',
        'remarks' => 'nullable|string'
    ]);

    $path = $request->file('receiptFile')->store('refunds', 'public');

    $refund = Refund::findOrFail($refundID);
    $refund->update([
        'refundStatus' => 'refunded',
        'completedAt' => now(),
        'receiptPath' => $path,
        'remarks' => $request->remarks
    ]);

    return back()->with('success', 'Refund completed and proof receipt sent to customer!');
}
</pre>
            </td>
        </tr>
    </tbody>
</table>

</body>
</html>
